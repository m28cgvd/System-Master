    days[r.dateKey] = 1;
    var k = atNormId_(r.employeeId, b.directory.prefixes);
    var x = out[k] = out[k] || { employeeId: r.employeeId, name: r.name, full: 0, half: 0, absent: 0, missed: 0, penalty: 0, lines: [], ot: 0, otHours: 0, unapproved: 0 };
    if (r.otAmount > 0) { x.ot += r.otAmount; x.otHours += r.otHours; }
    if (r.unapproved) x.unapproved++;
    if (r.status === AT_FULL) x.full++; else if (r.status === AT_HALF) x.half++; else if (atMissed_(r.status)) x.missed++; else x.absent++;
    if (r.penaltyAmount > 0) {
