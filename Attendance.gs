/**
 * Bhanpuri is two locations everywhere: Bhanpuri (HQ) → group HQ, Bhanpuri (GFP) → group GFP (it used to be one "HQ" group,
 * and 2.3.2 briefly called the first one "MDO"). The HQ shifts and penalty rules are copied to GFP when they were shared.
 * Safe to run again — what is already right is left alone.
 */
function atUpgradeV232_() {
  var log = [], LOC = AT_SH.LOCATIONS, sh = atSheet_(LOC), C = atCols_(sh, LOC);
  if (__M.at) delete __M.at[LOC];
  var locs = atReadSheet_(LOC), shared = false;
  locs.forEach(function (r) {
    var loc = str_(r['Master Location']), key = str_(r['Group Key']).toUpperCase(), disp = str_(r['Group Display Name']);
    if (!/bhanpuri/i.test(loc)) return;
    var gfp = /gfp/i.test(loc), want = gfp ? 'GFP' : 'HQ';
    if (gfp && (key === 'HQ' || key === '')) shared = true;
    if (key === want && disp === want) return;
    sh.getRange(r.__row, C.pos['Group Key'] + 1).setValue(want);
    sh.getRange(r.__row, C.pos['Group Display Name'] + 1).setValue(want);
    if (/grouped with|MDO/i.test(str_(r['Notes'])) || !str_(r['Notes']))
      sh.getRange(r.__row, C.pos['Notes'] + 1).setValue(gfp ? 'Bhanpuri (GFP) — reported on its own as GFP.' : 'Bhanpuri (HQ) and anyone else at Bhanpuri who is not GFP — reported as HQ.');
    log.push(loc + ' → ' + want);
  });
  var fix = function (tab, idCol) {
    if (__M.at) delete __M.at[tab];
    var rows = atReadSheet_(tab), tsh = atSheet_(tab), TC = atCols_(tsh, tab), ids = {}, n = 0, copied = 0;
    rows.forEach(function (r) { if (idCol) ids[str_(r[idCol]).toUpperCase()] = 1; });
    var freeId = function (want) {
      var m = /^([A-Z]+)0*(\d+)$/.exec(want), pre = m ? m[1] : 'P', k = m ? Number(m[2]) : 1;
      while (ids[pre + pad_(k, 3)]) k++;
      ids[pre + pad_(k, 3)] = 1; return pre + pad_(k, 3);
    };
    var hasGfp = rows.some(function (r) { return str_(r['Group Key']).toUpperCase() === 'GFP'; });
    rows.forEach(function (r) {
      var g = str_(r['Group Key']).toUpperCase();
      if (g === 'MDO') { tsh.getRange(r.__row, TC.pos['Group Key'] + 1).setValue('HQ'); n++; g = 'HQ'; }
      if (g !== 'HQ' || !shared || hasGfp) return;
      var o = {}; AT_HEAD[tab].forEach(function (h) { o[h] = r[h]; }); o['Group Key'] = 'GFP';
      if (idCol) { var m = /^([A-Z]+)0*(\d+)$/.exec(str_(r[idCol]).toUpperCase()); o[idCol] = freeId(m ? m[1] + (200 + Number(m[2])) : 'P201'); }
      atAppend_(tab, o); copied++;
    });
    return [n, copied];
  };
  var fs = fix(AT_SH.SHIFTS, ''), fp = fix(AT_SH.PENALTY, 'Rule ID');
  if (fs[0] + fp[0]) log.push((fs[0] + fp[0]) + ' MDO shift / rule row(s) → HQ');
  if (fs[1] + fp[1]) log.push((fs[1] + fp[1]) + ' HQ shift / rule row(s) copied to GFP');
  if (!log.length) return 'HQ / GFP already separate';
  atBump_();
  return 'Attendance: ' + log.join(' · ');
}

