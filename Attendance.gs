  b.rows.forEach(function (r) { map[atNormId_(r.employeeId, b.directory.prefixes)] = r; if (r.uploadedId) map[atNormId_(r.uploadedId, b.directory.prefixes)] = map[atNormId_(r.uploadedId, b.directory.prefixes)] || r; });
  return { hasData: atDates_().some(function (x) { return x.key === dateIso; }), byKey: map, prefixes: b.directory.prefixes };
