/**
 * Month summary per employee for salary preparation:
 * { days: [uploaded date keys], byId: { normId: { full, half, absent, missed, penalty, lines[] } }, prefixes }
 */
function atMonthSummary_(fromIso, toIso) {
  var b = atBuild_(fromIso, toIso, null, false), out = {}, days = {};
